"</methods>\n"
"<constants><constant name=\"KEY_MULTI\" value=\"1\">[code]key[/code] value in [code]key_event[/code] and [code]key_state_changed[/code], an [code]XREALKeyType[/code]: the MULTI, or function, key.</constant><constant name=\"KEY_INCREASE\" value=\"2\">[code]key[/code] value: the brightness and volume INCREASE key.</constant><constant name=\"KEY_DECREASE\" value=\"3\">[code]key[/code] value: the brightness and volume DECREASE key.</constant><constant name=\"KEY_MENU\" value=\"4\">[code]key[/code] value: the MENU key.</constant><constant name=\"ACTION_CLICK\" value=\"1\">[code]action[/code] value in [code]key_event[/code], an [code]XREALClickType[/code]: a single click.</constant><constant name=\"ACTION_DOUBLE_CLICK\" value=\"2\">[code]action[/code] value in [code]key_event[/code]: a double click.</constant><constant name=\"ACTION_LONG_PRESS\" value=\"3\">[code]action[/code] value in [code]key_event[/code]: a long press.</constant><constant name=\"KEY_STATE_DOWN\" value=\"1\">[code]state[/code] value in [code]key_state_changed[/code], an [code]XREALKeyState[/code]: the key went down.</constant><constant name=\"KEY_STATE_UP\" value=\"2\">[code]state[/code] value in [code]key_state_changed[/code]: the key was released.</constant></constants>\n"
