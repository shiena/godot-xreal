"<constants><constant name=\"TRACKING_6DOF\" value=\"0\">[code]TrackingType[/code] for [code]switch_tracking_type[/code] and [code]get_tracking_type[/code], from the Unity [code]XREALPlugin.cs[/code] enum: 6DoF, meaning SLAM position and orientation, the recommended mode.</constant><constant name=\"TRACKING_3DOF\" value=\"1\">[code]TrackingType[/code]: 3DoF, IMU orientation only, with no position.</constant><constant name=\"TRACKING_0DOF\" value=\"2\">[code]TrackingType[/code]: 0DoF, with no head tracking.</constant><constant name=\"TRACKING_0DOF_STAB\" value=\"3\">[code]TrackingType[/code]: 0DoF with stabilization.</constant><constant name=\"FEATURE_RGB_CAMERA\" value=\"1\">[code]XREALSupportedFeature[/code] for [[code]Self::is_hmd_feature_supported[/code]]: the RGB camera.</constant><constant name=\"FEATURE_WEARING_STATUS\" value=\"2\">[code]XREALSupportedFeature[/code]: the proximity (wear) sensor.</constant><constant name=\"FEATURE_CONTROLLER\" value=\"3\">[code]XREALSupportedFeature[/code]: a handheld controller.</constant><constant name=\"FEATURE_HEAD_TRACKING_ROTATION\" value=\"4\">[code]XREALSupportedFeature[/code]: head-tracking rotation (3DoF).</constant><constant name=\"FEATURE_HEAD_TRACKING_POSITION\" value=\"5\">[code]XREALSupportedFeature[/code]: head-tracking position (6DoF).</constant><constant name=\"COMPONENT_RGB_CAMERA\" value=\"crate::ffi::component::RGB_CAMERA\">[code]XREALComponent[/code] id for the geometry getters: the RGB camera.</constant><constant name=\"COMPONENT_DISPLAY_LEFT\" value=\"crate::ffi::component::DISPLAY_LEFT\">[code]XREALComponent[/code] id: the left display.</constant><constant name=\"COMPONENT_DISPLAY_RIGHT\" value=\"crate::ffi::component::DISPLAY_RIGHT\">[code]XREALComponent[/code] id: the right display.</constant><constant name=\"COMPONENT_GRAYSCALE_LEFT\" value=\"crate::ffi::component::GRAYSCALE_CAMERA_LEFT\">[code]XREALComponent[/code] id: the left SLAM grayscale camera.</constant><constant name=\"COMPONENT_GRAYSCALE_RIGHT\" value=\"crate::ffi::component::GRAYSCALE_CAMERA_RIGHT\">[code]XREALComponent[/code] id: the right SLAM grayscale camera.</constant><constant name=\"PLANE_NONE\" value=\"0\">[code]PlaneDetectionMode[/code] flag for [[code]Self::set_plane_detection_mode[/code]] / [[code]Self::poll_planes[/code]]: detection off.</constant><constant name=\"PLANE_HORIZONTAL\" value=\"1\">[code]PlaneDetectionMode[/code] flag: detect horizontal planes (floors, tables).</constant><constant name=\"PLANE_VERTICAL\" value=\"2\">[code]PlaneDetectionMode[/code] flag: detect vertical planes (walls).</constant><constant name=\"PLANE_BOTH\" value=\"3\">[code]PlaneDetectionMode[/code] flag: detect both horizontal and vertical planes.</constant><constant name=\"ANCHOR_QUALITY_INSUFFICIENT\" value=\"0\">Anchor-quality level from [[code]Self::estimate_anchor_quality[/code]]: insufficient, so do not save here.</constant><constant name=\"ANCHOR_QUALITY_SUFFICIENT\" value=\"1\">Anchor-quality level: sufficient, the minimum recommended before saving.</constant><constant name=\"ANCHOR_QUALITY_GOOD\" value=\"2\">Anchor-quality level: good, a strong spot to save an anchor.</constant><constant name=\"MESH_LABEL_BACKGROUND\" value=\"0\">[code]NRMeshingVertexSemanticLabel[/code] for the [code]labels[/code] of [[code]Self::poll_mesh_blocks[/code]]: whatever the classifier did not place, which is the catch-all rather than an &quot;unknown surface&quot; class.</constant><constant name=\"MESH_LABEL_WALL\" value=\"1\">[code]NRMeshingVertexSemanticLabel[/code]: a wall.</constant><constant name=\"MESH_LABEL_BUILDING\" value=\"2\">[code]NRMeshingVertexSemanticLabel[/code]: a building exterior.</constant><constant name=\"MESH_LABEL_FLOOR\" value=\"4\">[code]NRMeshingVertexSemanticLabel[/code]: the floor or ground.</constant><constant name=\"MESH_LABEL_CEILING\" value=\"5\">[code]NRMeshingVertexSemanticLabel[/code]: the ceiling.</constant><constant name=\"MESH_LABEL_HIGHWAY\" value=\"6\">[code]NRMeshingVertexSemanticLabel[/code]: a road surface (the taxonomy is outdoor-first, so the label set carries classes an indoor scan never produces).</constant><constant name=\"MESH_LABEL_SIDEWALK\" value=\"7\">[code]NRMeshingVertexSemanticLabel[/code]: a pavement.</constant><constant name=\"MESH_LABEL_GRASS\" value=\"8\">[code]NRMeshingVertexSemanticLabel[/code]: grass.</constant><constant name=\"MESH_LABEL_DOOR\" value=\"10\">[code]NRMeshingVertexSemanticLabel[/code]: a door.</constant><constant name=\"MESH_LABEL_TABLE\" value=\"11\">[code]NRMeshingVertexSemanticLabel[/code]: a table top.</constant></constants>\n"
"\n"
